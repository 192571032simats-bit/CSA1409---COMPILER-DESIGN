#include <stdio.h>
#include <ctype.h>

int main()
{
    char str[100];
    int i, flag = 1;

    printf("Enter an identifier: ");
    scanf("%99s", str);

    if(!(isalpha(str[0]) || str[0] == '_'))
        flag = 0;

    for(i = 1; str[i] != '\0'; i++)
    {
        if(!(isalnum(str[i]) || str[i] == '_'))
        {
            flag = 0;
            break;
        }
    }

    if(flag)
        printf("Valid Identifier");
    else
        printf("Invalid Identifier");

    return 0;
}