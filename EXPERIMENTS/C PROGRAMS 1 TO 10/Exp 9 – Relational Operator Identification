#include <stdio.h>
#include <string.h>

int main()
{
    char op[5];

    printf("Enter a relational operator: ");
    scanf("%4s", op);

    if(strcmp(op, "==") == 0)
        printf("Equal To Operator");
    else if(strcmp(op, "!=") == 0)
        printf("Not Equal To Operator");
    else if(strcmp(op, ">") == 0)
        printf("Greater Than Operator");
    else if(strcmp(op, "<") == 0)
        printf("Less Than Operator");
    else if(strcmp(op, ">=") == 0)
        printf("Greater Than or Equal To Operator");
    else if(strcmp(op, "<=") == 0)
        printf("Less Than or Equal To Operator");
    else
        printf("Invalid Relational Operator");

    return 0;
}