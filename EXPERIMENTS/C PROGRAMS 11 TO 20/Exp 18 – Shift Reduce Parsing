#include <stdio.h>
#include <string.h>

int main()
{
    char input[100], stack[100];
    int top = -1, i = 0, reduced;

    printf("Enter expression (use i for identifier): ");
    scanf("%99s", input);

    strcat(input, "$");

    printf("\nStack\tInput\tAction\n");

    while(input[i] != '$' || top != 0 || stack[top] != 'E')
    {
        stack[++top] = input[i++];

        reduced = 1;

        while(reduced)
        {
            reduced = 0;

            if(top >= 0 && stack[top] == 'i')
            {
                stack[top] = 'F';
                printf("F -> i\n");
                reduced = 1;
            }
            else if(top >= 2 &&
                    stack[top-2] == 'F' &&
                    stack[top-1] == '*' &&
                    stack[top] == 'F')
            {
                top -= 2;
                stack[top] = 'F';
                printf("F -> F*F\n");
                reduced = 1;
            }
            else if(top >= 2 &&
                    stack[top-2] == 'F' &&
                    stack[top-1] == '+' &&
                    stack[top] == 'F')
            {
                top -= 2;
                stack[top] = 'E';
                printf("E -> E+E\n");
                reduced = 1;
            }
            else if(top >= 2 &&
                    stack[top-2] == '(' &&
                    stack[top-1] == 'E' &&
                    stack[top] == ')')
            {
                top -= 2;
                stack[top] = 'F';
                printf("F -> (E)\n");
                reduced = 1;
            }
            else if(top >= 0 && stack[top] == 'F')
            {
                stack[top] = 'E';
                printf("E -> F\n");
                reduced = 1;
            }
        }

        if(input[i] == '$' && top == 0 && stack[top] == 'E')
            break;
    }

    if(top == 0 && stack[top] == 'E' && input[i] == '$')
        printf("\nString Accepted");
    else
        printf("\nString Rejected");

    return 0;
}
