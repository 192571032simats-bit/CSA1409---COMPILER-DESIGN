#include <stdio.h>
#include <stdlib.h>

char input[100];
int pos = 0;

void E();
void T();
void F();

void E()
{
    T();

    while(input[pos] == '+')
    {
        pos++;
        T();
    }
}

void T()
{
    F();

    while(input[pos] == '*')
    {
        pos++;
        F();
    }
}

void F()
{
    if(input[pos] == 'i')
    {
        pos++;
    }
    else if(input[pos] == '(')
    {
        pos++;
        E();

        if(input[pos] == ')')
            pos++;
        else
        {
            printf("Rejected");
            exit(0);
        }
    }
    else
    {
        printf("Rejected");
        exit(0);
    }
}

int main()
{
    printf("Enter expression: ");
    scanf("%99s", input);

    E();

    if(input[pos] == '\0')
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
