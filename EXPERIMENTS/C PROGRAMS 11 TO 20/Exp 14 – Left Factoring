#include <stdio.h>
#include <string.h>

int main()
{
    char nt, s1[50], s2[50];
    int i = 0;

    printf("Enter non-terminal: ");
    scanf(" %c", &nt);

    printf("Enter first production: ");
    scanf("%49s", s1);

    printf("Enter second production: ");
    scanf("%49s", s2);

    while(s1[i] != '\0' && s2[i] != '\0' &&
          s1[i] == s2[i])
    {
        i++;
    }

    if(i == 0)
    {
        printf("No common prefix found.");
    }
    else
    {
        printf("\nAfter Left Factoring:\n");
        printf("%c -> ", nt);

        for(int j = 0; j < i; j++)
            printf("%c", s1[j]);

        printf("%c'\n", nt);

        printf("%c' -> ", nt);

        if(s1[i] == '\0')
            printf("#");
        else
            printf("%s", s1 + i);

        printf(" | ");

        if(s2[i] == '\0')
            printf("#");
        else
            printf("%s", s2 + i);

        printf("\n");
    }

    return 0;
}
