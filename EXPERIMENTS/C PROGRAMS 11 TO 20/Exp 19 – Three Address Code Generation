#include <stdio.h>
#include <ctype.h>
#include <string.h>

char stack[100], postfix[100];
int top = -1;

int precedence(char op)
{
    if(op == '*' || op == '/')
        return 2;

    if(op == '+' || op == '-')
        return 1;

    return 0;
}

int main()
{
    char exp[100];
    int i, j = 0, temp = 1;

    printf("Enter an expression: ");
    scanf("%99s", exp);

    for(i = 0; exp[i] != '\0'; i++)
    {
        if(isalnum((unsigned char)exp[i]))
        {
            postfix[j++] = exp[i];
        }
        else if(exp[i] == '(')
        {
            stack[++top] = exp[i];
        }
        else if(exp[i] == ')')
        {
            while(top >= 0 && stack[top] != '(')
                postfix[j++] = stack[top--];

            if(top >= 0)
                top--;
        }
        else
        {
            while(top >= 0 && stack[top] != '(' &&
                  precedence(stack[top]) >= precedence(exp[i]))
            {
                postfix[j++] = stack[top--];
            }

            stack[++top] = exp[i];
        }
    }

    while(top >= 0)
        postfix[j++] = stack[top--];

    postfix[j] = '\0';

    printf("\nThree Address Code:\n");

    char operands[100][20];
    top = -1;

    for(i = 0; postfix[i] != '\0'; i++)
    {
        if(isalnum((unsigned char)postfix[i]))
        {
            char value[20];
            sprintf(value, "%c", postfix[i]);
            strcpy(operands[++top], value);
        }
        else
        {
            char a[20], b[20], result[20];

            strcpy(b, operands[top--]);
            strcpy(a, operands[top--]);

            sprintf(result, "t%d", temp++);

            printf("%s = %s %c %s\n",
                   result, a, postfix[i], b);

            strcpy(operands[++top], result);
        }
    }

    printf("Result = %s\n", operands[top]);

    return 0;
}
